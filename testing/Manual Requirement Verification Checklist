# Create verification script verify_requirements.sh
cat > verify_requirements.sh << 'EOF'
#!/bin/bash

echo "=== INCEPTION REQUIREMENTS VERIFICATION ==="

# 1. Check all containers are running
echo -e "\n1. CONTAINER STATUS:"
docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

# 2. Check volumes are named volumes in correct location
echo -e "\n2. VOLUMES:"
docker volume ls | grep -E "wordpress_volume|mariadb_volume"
docker volume inspect wordpress_volume | grep Mountpoint
docker volume inspect mariadb_volume | grep Mountpoint

# 3. Check network
echo -e "\n3. NETWORK:"
docker network ls | grep inception_network
docker network inspect inception_network | grep -A 5 Containers

# 4. Check restart policy
echo -e "\n4. RESTART POLICY:"
docker inspect nginx wordpress mariadb | grep -A 3 RestartPolicy

# 5. Check no infinite loops
echo -e "\n5. PROCESS CHECK (should be actual daemons, not tail -f):"
docker exec nginx ps aux | grep -E "nginx|tail|sleep|while"
docker exec wordpress ps aux | grep -E "php-fpm|tail|sleep"
docker exec mariadb ps aux | grep -E "mysqld|tail|sleep"

# 6. Check TLS configuration
echo -e "\n6. TLS CONFIGURATION:"
docker exec nginx nginx -T 2>&1 | grep ssl_protocols

# 7. Check environment variables (no hardcoded passwords)
echo -e "\n7. ENVIRONMENT VARIABLES:"
docker exec wordpress env | grep -E "MYSQL|WP_"
docker exec mariadb env | grep MYSQL

# 8. Check ports exposure
echo -e "\n8. PORT EXPOSURE:"
docker port nginx
EOF

chmod +x verify_requirements.sh
./verify_requirements.sh